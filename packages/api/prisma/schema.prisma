// Prisma schema for the Ratio API persistence layer.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// This schema targets SQLite for local development and tests
// (DATABASE_URL="file:./dev.db"). Migrations are provider-specific, so
// production/Docker uses a separate PostgreSQL variant instead of switching
// this file in place: see prisma/postgresql/schema.prisma for the schema,
// migrations, and the commands to (re)generate/migrate it.
datasource db {
  provider = "sqlite"
}

model ExchangeRate {
  id      Int    @id @default(autoincrement())
  isoCode String @map("iso_code")

  /// Decimal stored as string, never Float — avoids floating-point precision errors.
  rate String

  source      String
  extractedAt DateTime @map("extracted_at")

  @@index([isoCode, source, extractedAt])
  @@map("exchange_rates")
}
