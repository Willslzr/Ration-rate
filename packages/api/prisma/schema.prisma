// Prisma schema for the Ratio API persistence layer.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Datasource is controlled entirely by DATABASE_URL:
//   - development: "file:./dev.db" (SQLite)
//   - production:  a PostgreSQL connection string
// To switch providers: change `provider` below to "postgresql", point
// DATABASE_URL at the Postgres instance, and regenerate migrations for
// that provider (SQLite and PostgreSQL migrations are not interchangeable).
datasource db {
  provider = "sqlite"
}
