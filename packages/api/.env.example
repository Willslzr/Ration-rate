# SQLite for development; a PostgreSQL connection string in production
# (see the provider-switch comment in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# development | test | production
NODE_ENV="development"

# Cron expression for the scraping schedule (default: every hour)
CRON_EXPRESSION="0 * * * *"

# Optional: leave unset to fall back to a NoopNotifier that only logs
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
