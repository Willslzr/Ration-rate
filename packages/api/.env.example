# SQLite for development; a PostgreSQL connection string in production
# (see the provider-switch comment in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# development | test | production
NODE_ENV="development"

# HTTP port the API server listens on
PORT="3000"

# Cron expression for the scraping schedule (default: every hour)
CRON_EXPRESSION="0 * * * *"

# Optional: leave unset to fall back to a NoopNotifier that only logs
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Required: comma-separated list of valid x-api-key values for /v1/rates/*
API_KEYS="change-me-in-production"

# Requests allowed per minute per API key (or per IP if none), default 100
RATE_LIMIT_MAX="100"
