{
  "name": "@willslzr/ration",
  "version": "0.1.2",
  "description": "Lightweight TypeScript SDK for South American currency exchange rates — VES (BCV official + parallel), ARS (official + blue), EUR, COP, and MXN. Zero runtime dependencies, dual ESM/CJS.",
  "keywords": [
    "exchange-rate",
    "exchange-rates",
    "currency",
    "currency-converter",
    "currency-api",
    "dollar",
    "dolar",
    "tasa-dolar",
    "tasa-de-cambio",
    "usd",
    "bcv",
    "venezuela",
    "argentina",
    "dolar-blue",
    "euro",
    "colombia",
    "mexico",
    "south-america",
    "latam",
    "sdk",
    "api-client",
    "typescript"
  ],
  "license": "MIT",
  "author": "willslzr",
  "repository": {
    "type": "git",
    "url": "https://github.com/Willslzr/Ration-rate.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Willslzr/Ration-rate/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/Willslzr/Ration-rate/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@ratio/api": "workspace:*",
    "@ratio/core": "workspace:*",
    "tsup": "^8.5.1"
  }
}
