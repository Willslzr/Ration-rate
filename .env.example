# Used by docker-compose.yml (docker compose reads .env from this directory
# automatically). Every variable has a sensible default baked into
# docker-compose.yml, so `docker compose up` works even without a .env file —
# copy this to .env and adjust for anything beyond local testing.

# PostgreSQL (the api service's DATABASE_URL is built from these)
POSTGRES_USER=ratio
POSTGRES_PASSWORD=ratio
POSTGRES_DB=ratio

# API
PORT=3000
NODE_ENV=production
# Required in a real deployment — comma-separated x-api-key values for /v1/rates/*
API_KEYS=change-me-in-production
RATE_LIMIT_MAX=100
CRON_EXPRESSION=0 * * * *

# Optional: leave unset to fall back to a NoopNotifier that only logs
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
